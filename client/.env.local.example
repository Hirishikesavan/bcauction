# ─── LOCAL DEVELOPMENT (.env.local) ──────────────────────────
# Copy this file to .env.local and fill in your values

# Backend URL — local dev
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Better Auth secret — MUST match server's BETTER_AUTH_SECRET exactly
BETTER_AUTH_SECRET=same-secret-as-server-32chars-min

# Frontend URL — for local dev
NEXT_PUBLIC_APP_URL=http://localhost:3000

# UPI / Google Pay QR Code
NEXT_PUBLIC_UPI_ID=your_upi_id@upi
