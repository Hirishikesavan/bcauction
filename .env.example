# ════════════════════════════════════════════════════════════════════
# BEAST CRICKET — Environment Variables Reference
# Copy this file to .env (server) and .env.local (client) and fill in.
# On Railway: add these as Environment Variables in the dashboard.
# ════════════════════════════════════════════════════════════════════

# ── DATABASE ─────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/beast-cricket

# ── SERVER ───────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-nextjs-app.up.railway.app
BACKEND_URL=https://your-express-backend.up.railway.app

# ── AUTH (Better Auth) ───────────────────────────────────────────
BETTER_AUTH_SECRET=your-32-char-secret-here
BETTER_AUTH_URL=https://your-express-backend.up.railway.app

# ── RAZORPAY ─────────────────────────────────────────────────────
# TEST keys  (use during development and Razorpay KYC)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_key_here

# LIVE keys  (replace after Razorpay approves your account — NO code change needed)
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_live_secret_key_here

# Webhook secret — set in Razorpay Dashboard → Webhooks → Secret
# Required for production webhook signature verification
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_from_razorpay_dashboard

# Public key (exposed to browser) — MUST match RAZORPAY_KEY_ID
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ── PLATFORM FEES ────────────────────────────────────────────────
# Auction creation fee in paise (49900 = ₹499)
AUCTION_CREATION_FEE_PAISE=49900

# ── EMAIL (Nodemailer) ───────────────────────────────────────────
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
ADMIN_EMAIL=admin@yourdomain.com

# ── CLOUDINARY (optional — for image hosting) ────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── CLIENT (Next.js) ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-express-backend.up.railway.app/api
