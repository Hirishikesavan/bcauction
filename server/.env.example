# ─── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── Database ─────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/beast-cricket-auction

# ─── Better Auth (REQUIRED) ────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=your-32-char-secret-here
BACKEND_URL=https://your-backend.railway.app

# ─── Frontend URL ─────────────────────────────────────────────
FRONTEND_URL=https://your-frontend.railway.app

# ─── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Email (Gmail SMTP) ───────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-app-password

# ─── Admin (comma-separated for multiple admins) ───────────────
ADMIN_EMAIL=hirishi2020@gmail.com,hirishidraj07@gmail.com

# ─── Cloudinary (for player images) ──────────────────────────
# Option 1: Use individual credentials (get these from your Cloudinary
# dashboard: Settings -> API Keys -- do NOT use the literal text below,
# it is a placeholder and will be rejected by the app's validation)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Option 2: Use Cloudinary URL instead of the three vars above
# (format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME)
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# ─── Razorpay ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx
AUCTION_CREATION_FEE_PAISE=49900

# ─── Package Prices (optional overrides, in paise) ────────────
# PACKAGE_STARTER_PAISE=49900
# PACKAGE_PRO_PAISE=99900
# PACKAGE_ELITE_PAISE=199900
