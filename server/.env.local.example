# ─── LOCAL DEVELOPMENT (.env) ────────────────────────────────
PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/beast-cricket-auction

# Must be 32+ chars, same on client .env.local
BETTER_AUTH_SECRET=generate-with-node-crypto-32chars

# For local dev, backend runs on 5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-app-password

ADMIN_EMAIL=your-admin-email@example.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx
AUCTION_CREATION_FEE_PAISE=49900
